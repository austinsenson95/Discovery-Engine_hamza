# =============================================================================
# DISCOVERY ENGINE - Backend Environment Configuration
# =============================================================================

# Server
PORT=3001
NODE_ENV=development

# Frontend (CORS) — update with your deployed frontend URL
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# JWT (generate a strong random secret for production)
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# LLM API Keys — fill in the one you want to use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# Database (PostgreSQL — required in production)
# For local dev: postgresql://localhost:5432/discovery_engine
# For Supabase (serverless): use the Connection Pooler URL on port 6543
# Example: postgresql://postgres:[password]@db.[project].supabase.co:6543/postgres?pgbouncer=true
DATABASE_URL=

# Logging
LOG_LEVEL=debug

# Razorpay Payment Integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# =============================================================================
# Email Configuration (SMTP) — For password reset emails
# =============================================================================
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Discovery Engine"
SMTP_FROM_EMAIL=noreply@discoveryengine.app
