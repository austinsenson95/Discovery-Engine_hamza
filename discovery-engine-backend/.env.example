# =============================================================================
# DISCOVERY ENGINE - Backend Environment Configuration
# =============================================================================

# Server
PORT=3001
NODE_ENV=development

# Frontend (CORS) — update with your deployed frontend URL
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# JWT (generate a strong random secret for production)
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# =============================================================================
# DATABASE (Supabase — REQUIRED for production/serverless)
# =============================================================================
# 
# 1. Go to https://supabase.com → New Project
# 2. Project Settings → Database → Connection Pooler
# 3. Copy the URI (port 6543, NOT 5432)
# 
# Example:
# DATABASE_URL=postgresql://postgres.xxxxxxx:PASSWORD@aws-0-xxxxx.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# ⚠️  ALWAYS use port 6543 (Connection Pooler) for Vercel/serverless.
#    Port 5432 (Direct) will hit connection limits quickly.
#
# Leave empty for local SQLite fallback (development only).
DATABASE_URL=

# =============================================================================
# LLM API Keys — fill in the one you want to use
# =============================================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# Logging
LOG_LEVEL=debug

# =============================================================================
# Razorpay Payment Integration (optional)
# =============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# =============================================================================
# Email Configuration (SMTP) — For password reset emails
# =============================================================================
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Discovery Engine"
SMTP_FROM_EMAIL=noreply@discoveryengine.app
